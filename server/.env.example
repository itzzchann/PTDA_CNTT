# Copy thành server/.env rồi điền giá trị thật. KHÔNG commit file .env.
PORT=3000
DATABASE_URL=postgres://rophim:rophim@localhost:5432/rophim
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
JWT_EXPIRES_IN=7d
